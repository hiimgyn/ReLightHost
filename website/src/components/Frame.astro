---
/** Window-style frame around a real app screenshot, shared look with the GPM Hub landing mocks. */
const { title, class: cls } = Astro.props as { title: string; class?: string };
---

<figure class:list={['overflow-hidden rounded-2xl border border-[#262F4D] bg-[#0E1428]/90 shadow-[0_40px_100px_-30px_rgba(0,0,0,0.8)] backdrop-blur', cls]}>
  <div class="flex items-center gap-2 border-b border-[#262F4D] px-4 py-2.5">
    <span class="size-2.5 shrink-0 rounded-full bg-[#3A4466]"></span>
    <span class="size-2.5 shrink-0 rounded-full bg-[#3A4466]"></span>
    <span class="size-2.5 shrink-0 rounded-full bg-[#3A4466]"></span>
    <span class="ml-2 truncate text-xs text-[#8F98B5]">{title}</span>
  </div>
  <slot />
</figure>
