---
import { Picture } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  AppWindow, Cable, Download, Gauge, History, Library, Link2, Mic, PanelBottom, ShieldCheck,
  SlidersHorizontal, Sparkles, WavesHorizontal,
} from '@lucide/astro';
import Frame from '@/components/Frame.astro';
import { languages, ui, REPO, DOWNLOAD, type Lang } from '@/i18n/ui';
import icon from '@/assets/icon.png';
import app from '@/assets/app.webp';
import chain from '@/assets/chain.webp';
import proq from '@/assets/proq.webp';
import clear from '@/assets/clear.webp';

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const home = getRelativeLocaleUrl(lang, '');
const featureIcons = [Link2, Library, AppWindow, ShieldCheck, Cable, Gauge, History, PanelBottom];
const processorIcons = [Sparkles, WavesHorizontal, SlidersHorizontal, Mic];
const formats = ['VST3', 'VST2', 'CLAP', 'ASIO', 'WASAPI'];
const nav = [
  ['#features', t.nav.features],
  ['#showcase', t.nav.showcase],
  ['#processors', t.nav.processors],
  ['#tech', t.nav.tech],
] as const;
const ghPath =
  'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z';

const focus = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#B07CF8]';
const cta = `inline-flex items-center gap-2 rounded-full bg-[#8B3DF0] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#7A2EDB] ${focus}`;
const ghost = `inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-medium text-[#C3C9DB] transition-colors hover:text-white ${focus}`;
const h2 = 'font-display text-3xl font-extrabold leading-tight text-balance text-white sm:text-[2.75rem]';
const lead = 'mt-4 max-w-md text-[17px] leading-relaxed text-[#A3ACC4]';
const shot = { formats: ['avif', 'webp'], fallbackFormat: 'webp' } as const;
---

<div id="scene" aria-hidden="true" class="fixed inset-0 [&>canvas]:block [&>canvas]:size-full"></div>

<header class="fixed inset-x-0 top-0 z-10 bg-[#070A14]/30 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center gap-2 px-4 py-4 sm:px-6">
    <a href={home} class={`mr-auto flex items-center gap-2.5 rounded-lg ${focus}`}>
      <img src={icon.src} width="30" height="30" alt="" class="size-[30px]" />
      <span class="font-display text-lg font-extrabold text-white">ReLightHost</span>
    </a>
    <nav class="hidden items-center gap-1 lg:flex">
      {nav.map(([href, label]) => <a href={href} class={`rounded-full px-3.5 py-2 text-sm text-[#C3C9DB] transition-colors hover:text-white ${focus}`}>{label}</a>)}
    </nav>
    <div class="flex items-center text-xs" aria-label={t.footer.lang}>
      {(Object.keys(languages) as Lang[]).map((l) => (
        <a
          href={getRelativeLocaleUrl(l, '')}
          hreflang={l}
          lang={l}
          title={languages[l]}
          aria-current={l === lang ? 'page' : undefined}
          class:list={['rounded-full px-2.5 py-2 uppercase transition-colors', l === lang ? 'text-white' : 'text-[#7D86A3] hover:text-white', focus]}
        >{l}</a>
      ))}
    </div>
    <a href={DOWNLOAD} class={`ml-1 rounded-full border border-white/20 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/10 ${focus}`}>{t.nav.download}</a>
  </div>
</header>

<main class="relative">
  <section class="flex min-h-svh flex-col justify-end px-4 pb-20 sm:px-6">
    <div class="mx-auto w-full max-w-6xl [text-shadow:0_2px_30px_#070A14]">
      <h1 class="font-display max-w-4xl text-[2.6rem] font-extrabold leading-[1.02] tracking-[-0.02em] text-balance text-white sm:text-6xl lg:text-[5.25rem]">
        {t.hero.title1} {t.hero.title2}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[#B4BCD2]">{t.hero.sub}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={DOWNLOAD} class={cta}><Download class="size-4" />{t.hero.cta}</a>
        <a href={REPO} class={ghost}><svg viewBox="0 0 24 24" class="size-4 fill-current opacity-80" aria-hidden="true"><path d={ghPath} /></svg>{t.hero.github}</a>
      </div>
      <p class="mt-6 text-sm text-[#7D86A3]">{t.hero.badge}</p>
    </div>
  </section>

  <!-- Tall top padding leaves room for the particle chain (stage 1) between the hero and this copy. -->
  <section id="chain" data-stage="1" class="scroll-mt-20 px-4 pt-[38svh] sm:px-6">
    <div class="mx-auto max-w-6xl">
      <h2 class={h2}>{t.chain.title}</h2>
      <p class={`${lead} max-w-xl`}>{t.chain.sub}</p>
      <Frame title={`ReLightHost · ${t.chain.eyebrow}`} class="mt-10">
        <div class="overflow-x-auto">
          <Picture src={chain} alt={t.chain.alt} {...shot} widths={[800, 1600, 2400]} sizes="(min-width: 1152px) 1152px, 100vw" class="block h-auto w-full min-w-[640px]" />
        </div>
      </Frame>
      <div class="mt-8 flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <p class="text-sm text-[#7D86A3]">{t.formats}</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-1" aria-label={t.formats}>
          {formats.map((f) => <li class="font-display text-lg font-extrabold tracking-wide text-[#C3C9DB]">{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="showcase" class="scroll-mt-20 px-4 py-24 sm:px-6">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <h2 class={h2}>{t.showcase.title}</h2>
        <p class={lead}>{t.showcase.sub}</p>
      </div>
      <div class="relative pb-24 sm:pb-36">
        <Frame title="FabFilter Pro-Q 4">
          <Picture src={proq} alt={t.showcase.proq} {...shot} widths={[700, 1400]} sizes="(min-width: 1024px) 680px, 100vw" class="block h-auto w-full" />
        </Frame>
        <Frame title="Supertone Clear" class="absolute bottom-0 left-0 w-3/5 lg:-left-12">
          <Picture src={clear} alt={t.showcase.clear} {...shot} widths={[500, 1000]} sizes="(min-width: 1024px) 400px, 60vw" class="block h-auto w-full" />
        </Frame>
      </div>
    </div>
  </section>

  <section id="processors" class="scroll-mt-20 px-4 py-24 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <h2 class={h2}>{t.processors.title}</h2>
        <p class={lead}>{t.processors.sub}</p>
      </div>
      <ul class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
        {t.processors.items.map((p, i) => {
          const Icon = processorIcons[i];
          return (
            <li class="border-t border-[#262F4D] pt-5">
              <Icon class="size-5 text-[#B07CF8]" />
              <h3 class="mt-3 font-semibold text-white">{p.t}</h3>
              <p class="mt-1.5 text-[15px] leading-relaxed text-[#A3ACC4]">{p.d}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section id="tech" class="scroll-mt-20 px-4 py-24 sm:px-6">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
      <div class="lg:order-2">
        <h2 class={h2}>{t.tech.title}</h2>
        <p class={lead}>{t.tech.sub}</p>
        <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-6">
          {t.tech.stats.map((s) => (
            <div class="flex flex-col-reverse border-t border-[#262F4D] pt-4">
              <dt class="mt-1 text-sm text-[#7D86A3]">{s.l}</dt>
              <dd class="font-display text-2xl font-extrabold text-white">{s.v}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-8 text-sm text-[#7D86A3]">Rust · Tauri 2 · CPAL · React 19 · DeepFilterNet · RNNoise</p>
      </div>
      <Frame title="ReLightHost">
        <Picture src={app} alt={t.hero.alt} {...shot} widths={[800, 1400, 2000]} sizes="(min-width: 1024px) 680px, 100vw" class="block h-auto w-full" />
      </Frame>
    </div>
  </section>

  <section id="features" class="scroll-mt-20 px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <h2 class={`${h2} max-w-2xl`}>{t.features.title}</h2>
      <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {t.features.items.map((f, i) => {
          const Icon = featureIcons[i];
          return (
            <li class="border-t border-[#262F4D] pt-5">
              <Icon class="size-5 text-[#B07CF8]" />
              <h3 class="mt-3 font-semibold text-white">{f.t}</h3>
              <p class="mt-1.5 text-[15px] leading-relaxed text-[#A3ACC4]">{f.d}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section id="download" data-stage="2" class="flex min-h-[110svh] items-center px-4 sm:px-6">
    <div class="mx-auto w-full max-w-6xl [text-shadow:0_2px_30px_#070A14]">
      <h2 class={`${h2} max-w-md`}>{t.cta.title}</h2>
      <p class={lead}>{t.cta.sub}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={DOWNLOAD} class={cta}><Download class="size-4" />{t.hero.cta}</a>
      </div>
      <p class="mt-5 text-sm text-[#7D86A3]">{t.cta.note}</p>
    </div>
  </section>
</main>

<footer class="relative overflow-hidden border-t border-[#1E2642] bg-[#060912]">
  <div class="relative mx-auto grid max-w-6xl gap-10 px-4 pb-6 pt-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href={home} class={`inline-flex items-center gap-2.5 rounded-lg ${focus}`}>
        <img src={icon.src} width="28" height="28" alt="" class="size-7" />
        <span class="font-display text-lg font-extrabold text-white">ReLightHost</span>
      </a>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-[#7D86A3]">{t.cta.note}</p>
    </div>
    <nav aria-label={t.nav.features} class="flex flex-col gap-2.5 text-sm">
      {nav.map(([href, label]) => <a href={href} class={`w-fit text-[#A3ACC4] transition-colors hover:text-white ${focus}`}>{label}</a>)}
    </nav>
    <div class="flex flex-col gap-2.5 text-sm md:items-end">
      <a href={DOWNLOAD} class={`w-fit text-[#C3C9DB] transition-colors hover:text-white ${focus}`}>{t.nav.download}</a>
      <a href={REPO} class={`group inline-flex w-fit items-center gap-2 text-[#C3C9DB] transition-colors hover:text-white ${focus}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 fill-current opacity-70 transition-opacity group-hover:opacity-100"><path d={ghPath} /></svg>
        GitHub
      </a>
      <span class="text-[#5A6380]">© {new Date().getFullYear()} ReLightHost · {t.footer.made}</span>
    </div>
  </div>
  <!-- Oversized wordmark, cut off by the page edge and fading into it. -->
  <div
    aria-hidden="true"
    class="font-display pointer-events-none -mb-[0.22em] select-none whitespace-nowrap px-4 text-center text-[clamp(3.25rem,15vw,13rem)] font-extrabold leading-none tracking-[-0.04em] text-transparent sm:px-6"
    style="background-image: linear-gradient(180deg, rgba(176,124,248,0.24), rgba(176,124,248,0) 85%); -webkit-background-clip: text; background-clip: text"
  >
    ReLightHost
  </div>
</footer>

<script>
  import { mountScene } from '@/scripts/scene';
  const el = document.getElementById('scene');
  if (el) {
    const dispose = mountScene(el);
    addEventListener('pagehide', (e) => { if (!e.persisted) dispose(); });
  }
</script>
