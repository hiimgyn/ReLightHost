---
import { Picture } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  ArrowRight, AppWindow, AudioLines, Cable, Cpu, Download, Gauge, History, Library,
  Link2, Mic, PanelBottom, ShieldCheck, SlidersHorizontal, Sparkles, Waves, Zap,
} from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { Badge } from '@/components/ui/badge';
import { Card, CardTitle, CardDescription } from '@/components/ui/card';
import { languages, ui, REPO, DOWNLOAD, type Lang } from '@/i18n/ui';
import icon from '@/assets/icon.png';
import app from '@/assets/app.webp';
import chain from '@/assets/chain.webp';
import proq from '@/assets/proq.webp';
import clear from '@/assets/clear.webp';

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const featureIcons = [Link2, Library, AppWindow, ShieldCheck, Cable, Gauge, History, PanelBottom];
const processorIcons = [Sparkles, Waves, SlidersHorizontal, Mic];
const formats = ['VST3', 'VST2', 'CLAP', 'ASIO', 'WASAPI'];
const nav = [
  ['#features', t.nav.features],
  ['#showcase', t.nav.showcase],
  ['#processors', t.nav.processors],
  ['#tech', t.nav.tech],
] as const;
const ghPath =
  'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z';
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4">
  <nav class="glass mx-auto flex max-w-6xl items-center gap-4 rounded-full border px-3 py-2 pl-4">
    <a href={getRelativeLocaleUrl(lang, '')} class="flex items-center gap-2 font-semibold">
      <img src={icon.src} width="28" height="28" alt="" class="size-7" />
      <span>ReLight<span class="text-primary">Host</span></span>
    </a>
    <ul class="ml-4 hidden gap-1 text-sm text-muted-foreground md:flex">
      {nav.map(([href, label]) => <li><a href={href} class="rounded-full px-3 py-1.5 transition hover:bg-accent hover:text-foreground">{label}</a></li>)}
    </ul>
    <div class="ml-auto flex items-center gap-1 text-xs" aria-label={t.footer.lang}>
      {(Object.keys(languages) as Lang[]).map((l) => (
        <a
          href={getRelativeLocaleUrl(l, '')}
          hreflang={l}
          lang={l}
          title={languages[l]}
          aria-current={l === lang ? 'page' : undefined}
          class:list={['rounded-full px-2.5 py-1.5 uppercase transition', l === lang ? 'bg-accent text-foreground' : 'text-muted-foreground hover:text-foreground']}
        >{l}</a>
      ))}
    </div>
    <a href={DOWNLOAD} class={cn(buttonVariants({ size: 'sm' }), 'hidden sm:inline-flex')}><Download />{t.nav.download}</a>
  </nav>
</header>

<main>
  <!-- Hero -->
  <section class="relative px-4 pt-36 pb-16 sm:pt-44">
    <div class="grid-bg pointer-events-none absolute inset-0 -z-10"></div>
    <div class="mx-auto max-w-4xl text-center">
      <div data-hero class="flex justify-center"><Badge variant="outline" className="glass"><Zap className="text-primary" />{t.hero.badge}</Badge></div>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-balance sm:text-6xl md:text-7xl">
        <span data-hero class="block">{t.hero.title1}</span>
        <span data-hero class="text-gradient block pb-2">{t.hero.title2}</span>
      </h1>
      <p data-hero class="mx-auto mt-6 max-w-2xl text-base text-pretty text-muted-foreground sm:text-lg">{t.hero.sub}</p>
      <div data-hero class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={DOWNLOAD} class={buttonVariants({ size: 'lg' })}><Download />{t.hero.cta}</a>
        <a href={REPO} class={buttonVariants({ size: 'lg', variant: 'outline' })}><svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={ghPath} /></svg>{t.hero.github}</a>
      </div>
    </div>

    <div class="mx-auto mt-16 max-w-6xl [perspective:1600px]">
      <div id="hero-shot" class="relative origin-top rounded-2xl border bg-card p-1.5 shadow-[0_40px_120px_-30px_oklch(0.55_0.22_290/0.6)] will-change-transform">
        <Picture
          src={app}
          alt={t.hero.alt}
          formats={['avif', 'webp']} fallbackFormat="webp"
          widths={[640, 1200, 1800, 2400]}
          sizes="(min-width: 1152px) 1152px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full rounded-xl"
        />
      </div>
    </div>
  </section>

  <!-- Formats -->
  <section class="px-4 py-10" aria-label={t.formats}>
    <p class="text-center text-sm text-muted-foreground">{t.formats}</p>
    <ul class="mx-auto mt-5 flex max-w-3xl flex-wrap justify-center gap-3">
      {formats.map((f) => <li data-reveal class="glass rounded-full border px-5 py-2 text-sm font-medium tracking-wide">{f}</li>)}
    </ul>
  </section>

  <!-- Signal chain -->
  <section id="chain" class="overflow-hidden px-4 py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p data-reveal class="text-sm font-medium text-primary">{t.chain.eyebrow}</p>
      <h2 data-reveal class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">{t.chain.title}</h2>
      <p data-reveal class="mt-5 text-pretty text-muted-foreground">{t.chain.sub}</p>
    </div>
    <div id="chain-shot" class="mx-auto mt-14 max-w-6xl overflow-x-auto rounded-2xl border bg-card p-1.5">
      <Picture src={chain} alt={t.chain.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[800, 1600, 2400]} sizes="(min-width: 1152px) 1152px, 100vw" class="h-auto w-full min-w-[720px] rounded-xl" />
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="scroll-mt-24 px-4 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <p data-reveal class="text-sm font-medium text-primary">{t.features.eyebrow}</p>
        <h2 data-reveal class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-5xl">{t.features.title}</h2>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.features.items.map((f, i) => {
          const Icon = featureIcons[i];
          return (
            <Card data-reveal className="glass transition hover:-translate-y-1 hover:border-primary/40">
              <span class="grid size-10 place-items-center rounded-xl bg-primary/15 text-primary"><Icon className="size-5" /></span>
              <CardTitle>{f.t}</CardTitle>
              <CardDescription>{f.d}</CardDescription>
            </Card>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Showcase -->
  <section id="showcase" class="scroll-mt-24 overflow-hidden px-4 py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_1.5fr]">
      <div>
        <p data-reveal class="text-sm font-medium text-primary">{t.showcase.eyebrow}</p>
        <h2 data-reveal class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">{t.showcase.title}</h2>
        <p data-reveal class="mt-5 text-pretty text-muted-foreground">{t.showcase.sub}</p>
      </div>
      <div class="relative pb-24 sm:pb-40">
        <figure data-parallax="-60" class="rounded-2xl border bg-card p-1.5 shadow-2xl">
          <Picture src={proq} alt={t.showcase.proq} formats={['avif', 'webp']} fallbackFormat="webp" widths={[700, 1400]} sizes="(min-width: 1024px) 680px, 100vw" class="h-auto w-full rounded-xl" />
        </figure>
        <figure data-parallax="40" class="absolute bottom-0 -left-4 w-3/5 rounded-2xl border bg-card p-1.5 shadow-2xl sm:-left-12">
          <Picture src={clear} alt={t.showcase.clear} formats={['avif', 'webp']} fallbackFormat="webp" widths={[500, 1000]} sizes="(min-width: 1024px) 400px, 60vw" class="h-auto w-full rounded-xl" />
        </figure>
      </div>
    </div>
  </section>

  <!-- Built-in processors -->
  <section id="processors" class="scroll-mt-24 px-4 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-2xl text-center">
        <p data-reveal class="text-sm font-medium text-primary">{t.processors.eyebrow}</p>
        <h2 data-reveal class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">{t.processors.title}</h2>
        <p data-reveal class="mt-5 text-pretty text-muted-foreground">{t.processors.sub}</p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2">
        {t.processors.items.map((p, i) => {
          const Icon = processorIcons[i];
          return (
            <Card data-reveal className="glass flex-row items-start gap-5">
              <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-primary to-violet text-primary-foreground"><Icon className="size-6" /></span>
              <div class="space-y-2">
                <CardTitle>{p.t}</CardTitle>
                <CardDescription>{p.d}</CardDescription>
              </div>
            </Card>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Tech -->
  <section id="tech" class="scroll-mt-24 px-4 py-24">
    <div class="glass mx-auto max-w-6xl rounded-3xl border p-8 sm:p-14">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p data-reveal class="text-sm font-medium text-primary">{t.tech.eyebrow}</p>
          <h2 data-reveal class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{t.tech.title}</h2>
          <p data-reveal class="mt-5 text-pretty text-muted-foreground">{t.tech.sub}</p>
        </div>
        <dl class="grid grid-cols-2 gap-4">
          {t.tech.stats.map((s) => (
            <div data-reveal class="rounded-2xl border bg-background/40 p-6">
              <dt class="text-sm text-muted-foreground">{s.l}</dt>
              <dd class="text-gradient mt-2 text-3xl font-semibold">{s.v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="mt-10 flex items-center gap-3 text-sm text-muted-foreground" data-reveal>
        <Cpu className="size-4 text-primary" /><AudioLines className="size-4 text-primary" />
        <span>Rust · Tauri 2 · CPAL · React 19 · DeepFilterNet · RNNoise</span>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="download" class="px-4 py-28">
    <div class="mx-auto max-w-3xl text-center">
      <img data-reveal src={icon.src} width="96" height="96" alt="ReLightHost" class="mx-auto size-24 drop-shadow-[0_10px_40px_oklch(0.6_0.22_290/0.6)]" />
      <h2 data-reveal class="mt-8 text-3xl font-semibold tracking-tight text-balance sm:text-5xl">{t.cta.title}</h2>
      <p data-reveal class="mt-5 text-muted-foreground">{t.cta.sub}</p>
      <div data-reveal class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={DOWNLOAD} class={buttonVariants({ size: 'lg' })}><Download />{t.hero.cta}<ArrowRight /></a>
      </div>
      <p class="mt-5 text-xs text-muted-foreground">{t.cta.note}</p>
    </div>
  </section>
</main>

<footer class="border-t px-4 py-8 text-sm text-muted-foreground">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 sm:flex-row">
    <span>© {new Date().getFullYear()} ReLightHost · {t.footer.made}</span>
    <a href={REPO} class="hover:text-foreground">GitHub</a>
  </div>
</footer>

<script>
  import { animate } from '@/scripts/animate';
  animate();
</script>
